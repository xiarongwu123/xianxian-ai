# compose.yaml reads SITE_ADDRESS before containers start.
# Use your domain for automatic HTTPS, for example: app.example.com
SITE_ADDRESS=app.example.com

API_HOST=0.0.0.0
API_PORT=8787
DATA_DIR=/app/data
DATABASE_FILE=xianxian.sqlite
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
CORS_ORIGIN=https://app.example.com
SMS_MODE=disabled

OPENAI_API_KEY=replace-with-a-new-provider-key
OPENAI_API_BASE=https://sub2api.claude-api.cn/v1
OPENAI_VISION_MODEL=gpt-5.6-sol
VISION_TIMEOUT_MS=120000
ANALYST_TIMEOUT_MS=150000
