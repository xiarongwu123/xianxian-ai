{
  "name": "xianxian-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "user:create": "tsx server/scripts/createUser.ts",
    "test:api": "tsx --test server/**/*.test.ts",
    "check:api": "tsc --noEmit -p server/tsconfig.json",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "lucide-react": "latest",
    "multer": "^2.2.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "tsx": "^4.23.12",
    "vite": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2"
  }
}
